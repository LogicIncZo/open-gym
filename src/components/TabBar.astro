---
import { u } from "../lib/url";
const here = Astro.url.pathname.replace(/^\/open-gym/, "").replace(/\/$/, "") || "/";
const tabs = [
  {
    href: "/",
    label: "Home",
    icon: '<path d="M4 11.5 12 4l8 7.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
  },
  {
    href: "/map",
    label: "Map",
    icon: '<path d="M9 4 3 6.5v13L9 17l6 2.5 6-2.5v-13L15 6.5 9 4z"/><path d="M9 4v13M15 6.5v13"/>',
  },
  {
    href: "/equipment",
    label: "Stations",
    icon: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
  },
  {
    href: "/parks",
    label: "Parks",
    icon: '<path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  },
  {
    href: "/contribute",
    label: "Record",
    icon: '<path d="M12 5v14M5 12h14"/>',
  },
];
const active = (href: string) =>
  href === "/" ? here === "/" : here === href || here.startsWith(href + "/");
---

<nav class="tabbar" aria-label="Sections">
  {tabs.map((t) => (
    <a href={u(t.href)} aria-current={active(t.href) ? "page" : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
      <span>{t.label}</span>
    </a>
  ))}
</nav>

---
interface Props {
  text?: string;
  label?: string;
}
const { text = "Share this page", label = "" } = Astro.props;
---

<div class="share" data-share data-share-text={text}>
  {label && <p class="share__label">{label}</p>}
  <div class="share__row">
    <button class="btn btn--sm btn--terra" data-share-action="wa" type="button">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.5 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.7-.1a11 11 0 0 1-4-2.5 11 11 0 0 1-2-2.9c-.2-.5-.4-1.1-.2-1.6.1-.4.6-1 1-1.2.2-.1.5-.1.7 0 .2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .6l-.4.6c-.1.2-.2.3 0 .6.5.8 1.2 1.5 2 2 .3.2.5.2.7 0l.7-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .2 0 .9-.2 1.4z"/></svg>
      WhatsApp
    </button>
    <button class="btn btn--sm" data-share-action="copy" type="button">Copy link</button>
    <button class="btn btn--sm" data-share-action="qr" type="button">QR</button>
    <button class="btn btn--sm" data-share-action="print" type="button">Print</button>
  </div>

  <dialog data-qr class="qr-dialog">
    <div class="qr-dialog__inner">
      <strong>Scan to open</strong>
      <div data-qr-canvas class="qr-dialog__img"></div>
      <p class="tiny muted" data-qr-url style="word-break:break-all;margin:0"></p>
      <button class="btn btn--sm" type="button" data-qr-close>Close</button>
    </div>
  </dialog>
</div>

<script>
  import "../scripts/share";
</script>

<style>
  .share {
    display: grid;
    gap: 8px;
  }
  .share__label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0;
  }
  .share__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .qr-dialog {
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper-2);
    padding: 0;
    max-width: 320px;
  }
  .qr-dialog::backdrop {
    background: rgba(34, 31, 25, 0.45);
  }
  .qr-dialog__inner {
    display: grid;
    gap: 10px;
    justify-items: center;
    padding: 18px;
    text-align: center;
  }
  .qr-dialog__img img {
    border-radius: 8px;
  }
</style>

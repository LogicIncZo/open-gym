---
import { u } from "../lib/url";
const here = Astro.url.pathname.replace(/^\/open-gym/, "").replace(/\/$/, "") || "/";
const links = [
  { href: "/equipment", label: "Equipment" },
  { href: "/parks", label: "Parks" },
  { href: "/build", label: "Build a park" },
  { href: "/safety", label: "Safety" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => here === href || here.startsWith(href + "/");
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={u("/")}>
      <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="2" y="2" width="36" height="36" rx="10" fill="#221f19"></rect>
        <path d="M10 30V13M30 30V13M8 13h24" stroke="#f6efe0" stroke-width="3.4" stroke-linecap="round" fill="none"></path>
        <circle cx="20" cy="22" r="4" fill="#b04a28"></circle>
        <path d="M20 26v4" stroke="#b04a28" stroke-width="3.4" stroke-linecap="round"></path>
      </svg>
      <span>Open&nbsp;Gym</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={u(l.href)} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

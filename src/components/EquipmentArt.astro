---
import { ART } from "../data/art";
import { photoFor } from "../data/photos";
import { u } from "../lib/url";

interface Props {
  id: string;
  alt: string;
  class?: string;
  ground?: boolean;
  eager?: boolean;
}

const { id, alt, class: cls = "", ground = true, eager = false } = Astro.props;
const art = ART[id] ?? "";
const photo = photoFor(id);
---

{
  photo ? (
    <img
      class={cls}
      src={u(`/photos/${photo.file}`)}
      alt={alt}
      width="1000"
      height="750"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  ) : (
    <svg
      class={cls}
      viewBox="0 0 240 160"
      role="img"
      aria-label={alt}
      preserveAspectRatio="xMidYMid meet"
      data-visual="schematic"
    >
      {ground && (
        <line x1="26" y1="134" x2="214" y2="134" stroke="#C8B593" stroke-width="4" stroke-linecap="round" />
      )}
      <Fragment set:html={art} />
    </svg>
  )
}

---
import Base from "../layouts/Base.astro";
import TabBar from "../components/TabBar.astro";
import { u } from "../lib/url";
import { EQUIPMENT } from "../data/equipment";
import { CATEGORIES } from "../data/types";
import { cityLabel, CITIES, cityStats } from "../data/parks";

const cities = CITIES.filter((c) => cityStats(c).total > 0);

const groups = CATEGORIES.filter((c) => c.id !== "multi").map((c) => ({
  id: c.id,
  label: c.label,
  ink: c.ink,
  tint: c.tint,
  stations: EQUIPMENT.filter((e) => e.category === c.id).map((e) => ({
    id: e.id,
    name: e.name,
  })),
}));
const multi = EQUIPMENT.filter((e) => e.category === "multi").map((e) => ({
  id: e.id,
  name: e.name,
}));

const AMENITY_ROWS = [
  { id: "toilets", label: "Toilets" },
  { id: "drinkingWater", label: "Drinking water" },
  { id: "lights", label: "Lights after dark" },
  { id: "shade", label: "Shade over the equipment" },
  { id: "benches", label: "Benches to sit on" },
  { id: "parking", label: "Parking" },
  { id: "fencing", label: "Fenced, locked at night" },
];
---

<Base
  title="Record a park — Open Gym"
  description="Stand in the park, share your location, tick the equipment you can see, add a photo. One anonymous GPS fix is enough to verify a park."
>
  <main class="rec">
    <header class="rec__intro">
      <p class="eyebrow">Field record</p>
      <h1>Record what is actually in the park</h1>
      <p class="rec__lede">
        Four steps. Nothing to sign up for. If your location fixes inside the park, the report
        counts as a field verification on its own — the park page goes up a rung and other people
        can trust the list.
      </p>
    </header>

    <ol class="rec-steps" aria-label="Report steps">
      <li class="step" data-step="1">
        <div class="step__head">
          <span class="step__num">1</span>
          <div>
            <h2>Fix your location</h2>
            <p class="step__sub">
              Used once, to check you are at the park. The fix is compared with the park pin and
              then kept as a rounded coordinate — never linked to you.
            </p>
          </div>
        </div>

        <div class="step__body">
          <button class="btn btn--terra btn--block" id="locate" type="button">
            Get my location
          </button>
          <div class="fixline" id="fixline" hidden>
            <span class="fixline__dot" aria-hidden="true"></span>
            <span id="fixline-text"></span>
          </div>
          <p class="step__fine" id="locate-note">
            On a laptop this uses wifi positioning and can be a block off. On a phone, stand in
            the middle of the park before tapping.
          </p>
          <button class="linkish" id="skip-gps" type="button">
            I can't share my location — record it as unchecked
          </button>
        </div>
      </li>

      <li class="step" data-step="2">
        <div class="step__head">
          <span class="step__num">2</span>
          <div>
            <h2>Which park</h2>
            <p class="step__sub">
              Nearest parks are listed first once you have a fix. Pick the one you are standing in.
            </p>
          </div>
        </div>

        <div class="step__body">
          <label class="field">
            <span>Search by name</span>
            <input id="park-q" type="search" placeholder="Gachibowli Park…" autocomplete="off" />
          </label>
          <div class="parklist" id="parklist" role="listbox" aria-label="Parks"></div>
          <p class="step__fine" id="park-empty" hidden>
            No park matches. You can add the one you are in below.
          </p>
          <details class="newpark">
            <summary>This park isn't listed</summary>
            <div class="newpark__body">
              <label class="field">
                <span>Park name</span>
                <input id="new-name" type="text" placeholder="Sector 12 neighbourhood park" />
              </label>
              <label class="field">
                <span>City</span>
                <select id="new-city">
                  {cities.map((c) => <option value={c}>{cityLabel(c)}</option>)}
                </select>
              </label>
              <p class="step__fine">
                A new park needs a location fix so the pin lands somewhere real. Without a fix it
                is filed as an unchecked contribution.
              </p>
            </div>
          </details>
        </div>
      </li>

      <li class="step" data-step="3">
        <div class="step__head">
          <span class="step__num">3</span>
          <div>
            <h2>What's there</h2>
            <p class="step__sub">
              Tick only what you can see. Leaving a station unticked means "not there", so a
              short honest list beats a long guess.
            </p>
          </div>
        </div>

        <div class="step__body">
          <div class="amen" id="amen">
            {AMENITY_ROWS.map((a) => (
              <label class="amen__row">
                <input type="checkbox" data-amen={a.id} />
                <span>{a.label}</span>
              </label>
            ))}
          </div>

          <div class="stations" id="stations">
            {groups.map((g) => (
              <div class="sgroup" data-group={g.id}>
                <h3 style={`color:${g.ink}`}>{g.label}</h3>
                <div class="sgrid">
                  {g.stations.map((s) => (
                    <button class="stog" type="button" data-id={s.id} aria-pressed="false">
                      {s.name}
                    </button>
                  ))}
                </div>
              </div>
            ))}
            <div class="sgroup" data-group="multi">
              <h3>Combination rigs</h3>
              <div class="sgrid">
                {multi.map((s) => (
                  <button class="stog" type="button" data-id={s.id} aria-pressed="false">
                    {s.name}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="picked" id="picked" hidden>
            <h3>Condition of what you ticked</h3>
            <div id="picked-list"></div>
          </div>
        </div>
      </li>

      <li class="step" data-step="4">
        <div class="step__head">
          <span class="step__num">4</span>
          <div>
            <h2>Photo and send</h2>
            <p class="step__sub">
              One photo of the equipment area is the single most useful thing you can add. It is
              resized on your phone, stripped of every metadata tag, and stored without your name.
            </p>
          </div>
        </div>

        <div class="step__body">
          <div class="photo">
            <input
              id="photo"
              type="file"
              accept="image/*"
              capture="environment"
              class="photo__input"
            />
            <label for="photo" class="photo__drop" id="photo-drop">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.2l1-1.6h6.6l1 1.6h1.2A2.5 2.5 0 0 1 20 8.5v9A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5z" />
                <circle cx="12" cy="13" r="3.4" />
              </svg>
              <span>Take or choose a photo</span>
            </label>
            <figure class="photo__preview" id="photo-preview" hidden>
              <img id="photo-img" alt="Preview of the photo you selected" />
              <button class="linkish" id="photo-clear" type="button">Remove photo</button>
            </figure>
          </div>

          <label class="field">
            <span>Anything else worth knowing (optional)</span>
            <textarea
              id="notes"
              rows="3"
              maxlength="600"
              placeholder="Seat on the chest press is cracked. No instructor. Busy before 8am."
            ></textarea>
          </label>

          <label class="consent">
            <input type="checkbox" id="consent" />
            <span>
              I understand this is published openly under CC BY-SA, with no name attached, and
              that the photo will be visible to everyone.
            </span>
          </label>

          <button class="btn btn--primary btn--block" id="send" type="button" disabled>
            Send the record
          </button>
          <p class="step__fine" id="send-note">
            Anonymous by default: the server keeps no IP address, no user agent and no cookie.
          </p>
        </div>
      </li>
    </ol>

    <section class="outcome" id="outcome" hidden aria-live="polite"></section>

    <section class="how">
      <h2>What happens to it</h2>
      <div class="how__grid">
        <div>
          <h3>Filed by trust, not by count</h3>
          <p>
            A fix within 150 m of the park pin files the report as
            <strong>GPS-verified on site</strong>. Outside that radius it is filed as
            <strong>contributed, not checked</strong>, and waits for someone else. There is no
            way to buy the higher label with a form field.
          </p>
        </div>
        <div>
          <h3>Photos carry no metadata</h3>
          <p>
            Your phone's EXIF block holds device model, timestamps and sometimes a precise
            location trail. It is dropped before the file is written. What is kept is the image
            and a hash of it, so a photo can be matched against a duplicate report.
          </p>
        </div>
        <div>
          <h3>Nothing is deleted quietly</h3>
          <p>
            A disagreement does not get averaged out. Two reports that disagree on the equipment
            list drop the park back a rung and both stay on the record.
          </p>
        </div>
      </div>
    </section>
  </main>
  <TabBar />
</Base>

<script is:inline define:vars={{ INTAKE: "https://cashlessconsumer.zo.space/api/gym-report", GEO: u("/data/parks.geojson") }}>
  const $ = (id) => document.getElementById(id);
  const MAX_M = 150;

  const state = {
    fix: null,
    fixDenied: false,
    parks: [],
    park: null,
    newPark: null,
    stations: new Map(),
    photo: null,
    sent: false,
  };

  const haversine = (aLat, aLon, bLat, bLon) => {
    const R = 6371000;
    const dLat = ((bLat - aLat) * Math.PI) / 180;
    const dLon = ((bLon - aLon) * Math.PI) / 180;
    const s =
      Math.sin(dLat / 2) ** 2 +
      Math.cos((aLat * Math.PI) / 180) * Math.cos((bLat * Math.PI) / 180) * Math.sin(dLon / 2) ** 2;
    return Math.round(2 * R * Math.asin(Math.sqrt(s)));
  };

  const metres = (m) => (m < 950 ? `${m} m` : `${(m / 1000).toFixed(1)} km`);

  function setStep(n, done) {
    const el = document.querySelector(`.step[data-step="${n}"]`);
    if (el) el.classList.toggle("is-done", done);
  }

  function note(msg) {
    const el = $("locate-note");
    el.textContent = msg;
    el.hidden = !msg;
  }

  function refreshSend() {
    const ok = Boolean(state.park || state.newPark) && document.getElementById("consent").checked;
    $("send").disabled = !ok;
  }

  /* ---------- location ---------- */
  $("locate").addEventListener("click", () => {
    const btn = $("locate");
    if (!navigator.geolocation) {
      note("This browser has no location API. You can still record the park — it will be filed as unchecked.");
      return;
    }
    btn.textContent = "Finding you…";
    btn.disabled = true;
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        state.fix = {
          lat: pos.coords.latitude,
          lon: pos.coords.longitude,
          accuracy: Math.round(pos.coords.accuracy),
        };
        btn.disabled = false;
        btn.textContent = "Update my location";
        note("");
        showFix();
        renderParks();
        setStep(1, true);
      },
      (err) => {
        btn.disabled = false;
        btn.textContent = "Try again";
        note(
          err.code === 1
            ? "Location was blocked. You can still record the park — it will be filed as unchecked."
            : "Could not get a fix. Move away from tree cover or step outside, then try again.",
        );
      },
      { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 },
    );
  });

  function showFix() {
    const f = state.fix;
    if (!f) return;
    const line = $("fixline");
    line.hidden = false;
    const near = state.park ? haversine(f.lat, f.lon, state.park.lat, state.park.lon) : null;
    $("fixline-text").textContent =
      `Fix ±${f.accuracy} m` + (near == null ? " — pick the park next" : ` — ${metres(near)} from the pin`);
    line.dataset.inside = near != null && near <= MAX_M ? "yes" : "no";
  }

  $("skip-gps").addEventListener("click", () => {
    state.fixDenied = true;
    note(
      "No location. The record will be filed as unchecked, which is honest — someone else can confirm it later.",
    );
    renderParks();
  });

  /* ---------- parks ---------- */
  const PARK_INDEX = [];
  async function loadParks() {
    try {
      const res = await fetch(GEO);
      const geo = await res.json();
      for (const f of geo.features) {
        if (f.properties.layer !== "park") continue;
        PARK_INDEX.push({
          slug: f.properties.slug,
          city: f.properties.city,
          name: f.properties.name,
          lat: f.geometry.coordinates[1],
          lon: f.geometry.coordinates[0],
          stations: f.properties.stations,
          href: f.properties.href,
        });
      }
    } catch (e) {
      /* park list is a convenience; the form still works with a new park */
    }
    state.parks = PARK_INDEX;
    preselect();
    renderParks();
  }

  /* A link from the map or a city page carries the park in the query string. */
  function preselect() {
    const q = new URLSearchParams(window.location.search);
    const slug = q.get("park");
    if (!slug) return;
    const city = q.get("city") || "";
    const hit = PARK_INDEX.find((p) => p.slug === slug && (!city || p.city === city));
    if (hit) {
      state.park = hit;
      setStep(2, true);
      refreshSend();
      return;
    }
    const name = q.get("name");
    if (name && name.trim().length >= 3) {
      state.newPark = { name: name.trim(), city: q.get("citySlug") || city || "hyderabad" };
      $("new-name").value = name.trim();
      if (city) $("new-city").value = city;
      setStep(2, true);
      refreshSend();
    }
  }

  function renderParks() {
    const q = ($("park-q").value || "").trim().toLowerCase();
    let rows = state.parks;
    if (q) rows = rows.filter((p) => p.name.toLowerCase().includes(q));
    if (state.fix) {
      rows = rows
        .map((p) => ({ ...p, distance: haversine(state.fix.lat, state.fix.lon, p.lat, p.lon) }))
        .sort((a, b) => a.distance - b.distance);
    }
    rows = rows.slice(0, q ? 12 : state.fix ? 5 : 8);

    const list = $("parklist");
    list.innerHTML = "";
    $("park-empty").hidden = rows.length > 0 || !q;

    for (const p of rows) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "parkitem";
      btn.setAttribute("role", "option");
      btn.setAttribute("aria-selected", state.park?.slug === p.slug && state.park?.city === p.city ? "true" : "false");
      const dist = p.distance != null ? `<span class="parkitem__d">${metres(p.distance)}</span>` : "";
      btn.innerHTML = `<span class="parkitem__n">${p.name}</span>${dist}`;
      btn.addEventListener("click", () => {
        state.park = p;
        state.newPark = null;
        document.querySelectorAll(".parkitem").forEach((n) => n.setAttribute("aria-selected", "false"));
        btn.setAttribute("aria-selected", "true");
        showFix();
        setStep(2, true);
        refreshSend();
      });
      list.appendChild(btn);
    }
  }
  $("park-q").addEventListener("input", renderParks);

  $("new-name").addEventListener("input", () => {
    const name = $("new-name").value.trim();
    if (name.length >= 3) {
      state.newPark = { name, city: $("new-city").value };
      state.park = null;
    } else {
      state.newPark = null;
    }
    refreshSend();
  });
  $("new-city").addEventListener("change", () => {
    if (state.newPark) state.newPark.city = $("new-city").value;
  });

  /* ---------- stations ---------- */
  const COND_LABEL = { good: "Good", fair: "Fair", poor: "Worn", broken: "Broken" };

  document.querySelectorAll(".stog").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.id;
      const on = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", on ? "false" : "true");
      if (on) state.stations.delete(id);
      else state.stations.set(id, "good");
      renderPicked();
      setStep(3, state.stations.size > 0);
    });
  });

  function renderPicked() {
    const wrap = $("picked");
    const list = $("picked-list");
    wrap.hidden = state.stations.size === 0;
    list.innerHTML = "";
    for (const [id, cond] of state.stations) {
      const name = document.querySelector(`.stog[data-id="${id}"]`)?.textContent?.trim() || id;
      const row = document.createElement("div");
      row.className = "picked__row";
      row.innerHTML = `<span class="picked__n">${name}</span>`;
      const seg = document.createElement("div");
      seg.className = "seg";
      for (const [k, label] of Object.entries(COND_LABEL)) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = label;
        b.setAttribute("aria-pressed", cond === k ? "true" : "false");
        b.addEventListener("click", () => {
          state.stations.set(id, k);
          renderPicked();
        });
        seg.appendChild(b);
      }
      row.appendChild(seg);
      list.appendChild(row);
    }
  }

  /* ---------- photo ---------- */
  async function shrink(file) {
    const bitmap = await createImageBitmap(file);
    const max = 1400;
    const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const w = Math.round(bitmap.width * scale);
    const h = Math.round(bitmap.height * scale);
    const canvas = document.createElement("canvas");
    canvas.width = w;
    canvas.height = h;
    canvas.getContext("2d").drawImage(bitmap, 0, 0, w, h);
    bitmap.close?.();
    return canvas.toDataURL("image/jpeg", 0.82);
  }

  $("photo").addEventListener("change", async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      state.photo = await shrink(file);
      $("photo-img").src = state.photo;
      $("photo-preview").hidden = false;
      $("photo-drop").classList.add("is-set");
    } catch (err) {
      state.photo = null;
      $("send-note").textContent = "That image could not be read. Try a different photo.";
    }
  });

  $("photo-clear").addEventListener("click", () => {
    state.photo = null;
    $("photo").value = "";
    $("photo-preview").hidden = true;
    $("photo-drop").classList.remove("is-set");
  });

  $("consent").addEventListener("change", refreshSend);

  /* ---------- send ---------- */
  $("send").addEventListener("click", async () => {
    const btn = $("send");
    const target = state.park
      ? { slug: state.park.slug, city: state.park.city, name: state.park.name, lat: state.park.lat, lon: state.park.lon }
      : state.newPark && state.fix
        ? {
            slug: (state.newPark.name || "unnamed-park")
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-+|-+$/g, "")
              .slice(0, 60),
            city: state.newPark.city,
            name: state.newPark.name,
            lat: state.fix.lat,
            lon: state.fix.lon,
          }
        : null;

    if (!target) {
      $("send-note").textContent =
        "A new park needs a location fix so the pin is real. Pick an existing park, or share your location.";
      return;
    }

    const amenities = {};
    document.querySelectorAll("[data-amen]").forEach((el) => {
      amenities[el.dataset.amen] = el.checked;
    });

    const body = {
      citySlug: target.city,
      parkSlug: target.slug,
      parkName: target.name,
      park: { lat: target.lat, lon: target.lon },
      fix: state.fix
        ? { lat: state.fix.lat, lon: state.fix.lon, accuracy: state.fix.accuracy }
        : { lat: target.lat, lon: target.lon, accuracy: null },
      stations: [...state.stations].map(([id, condition]) => ({ id, condition })),
      amenities,
      notes: $("notes").value.trim() || null,
      photo: state.photo ? { data: state.photo } : null,
    };

    btn.disabled = true;
    btn.textContent = "Sending…";

    try {
      const res = await fetch(INTAKE, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const out = await res.json();
      if (!res.ok) {
        btn.disabled = false;
        btn.textContent = "Send the record";
        $("send-note").textContent =
          (out?.problems || []).map((p) => p.message).join(". ") || out?.error || "The server refused the record.";
        return;
      }
      showOutcome(out);
    } catch (err) {
      btn.disabled = false;
      btn.textContent = "Send the record";
      $("send-note").textContent =
        "Could not reach the server. Nothing was saved. Try again when you have a signal — the equipment list is still in this tab.";
    }
  });

  function showOutcome(out) {
    const panel = $("outcome");
    const verified = out.verified === true;
    panel.hidden = false;
    panel.className = `outcome ${verified ? "outcome--ok" : "outcome--pending"}`;
    panel.innerHTML = `
      <h2>${verified ? "Verified on site" : "Filed, needs a second check"}</h2>
      <p>${out.message}</p>
      <dl class="outcome__figs">
        <div><dt>Distance from park pin</dt><dd>${metres(Number(out.distanceM) || 0)}</dd></div>
        <div><dt>Stations recorded</dt><dd>${body_station_count()}</dd></div>
        <div><dt>Report id</dt><dd class="mono">${String(out.id).slice(0, 8)}</dd></div>
      </dl>
      <p class="outcome__next">
        ${
          verified
            ? "The park page will show this list as GPS-verified. If you spot something wrong later, send another record — the newer one wins and the old one stays in the history."
            : "This one stays at the lower rung until someone standing in the park confirms it. If you are in the park, share your location and send again."
        }
      </p>
      <div class="outcome__acts">
        <a class="btn btn--sm" href="${target_href()}">Open the park page</a>
        <button class="btn btn--sm" id="again" type="button">Record another park</button>
      </div>
    `;
    panel.scrollIntoView({ behavior: "smooth", block: "start" });
    $("again")?.addEventListener("click", () => location.reload());
    setStep(4, true);
  }

  function body_station_count() {
    return state.stations.size;
  }

  function target_href() {
    const base = window.__BASE__ || "";
    if (state.park?.href) return base + state.park.href;
    return "#";
  }

  loadParks();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .rec {
    max-width: 760px;
    margin: 0 auto;
    padding: 26px var(--gutter) calc(var(--tabbar) + 40px);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terra);
    margin: 0 0 6px;
  }
  .rec__intro h1 {
    font-family: var(--font-display);
    font-size: clamp(26px, 6vw, 38px);
    line-height: 1.12;
    margin: 0 0 10px;
  }
  .rec__lede {
    color: var(--ink-2);
    margin: 0 0 22px;
    max-width: 54ch;
  }

  .rec-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .step {
    background: var(--paper-2);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
  }
  .step.is-done {

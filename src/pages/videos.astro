---
import Base from "../layouts/Base.astro";
import { ALL_VIDEOS, CREDENTIAL_LABEL, GENERAL_VIDEOS } from "../data/videos";
import { u } from "../lib/url";
---

<Base
  title="Video demos"
  description="Hand-picked, source-labelled video demonstrations of outdoor gym technique, from credentialed professionals and public-health bodies."
  path="/videos"
>
  <div class="wrap" style="padding-top:22px">
    <p class="eyebrow">Watch it done</p>
    <h1>Video demos</h1>
    <p class="muted" style="max-width:66ch">
      Short, external demonstrations chosen for who made them and what they actually show. A
      source label is shown for every video: we state a professional credential only when the
      publisher states one. These are a supplement to the station pages, not a safety check on the
      equipment in your park. Full attribution is on the <a href={u("/credits")}>credits page</a>.
    </p>

    <div class="callout callout--amber" style="margin-top:16px">
      <p class="callout__title">Before you copy a technique</p>
      <p class="small" style="margin-bottom:0">
        Check the hardware in front of you first — loose bolts, cracked welds and missing caps are
        common in unsupervised parks. Stop if a movement hurts. Video presenters are demonstrating
        on their own equipment, not clearing yours.
      </p>
    </div>

    <section class="detail-section" id="all">
      <h2><span class="num">01</span> All curated videos</h2>
      <ul class="videolist">
        {ALL_VIDEOS.map((v) => (
          <li>
            <a class="videolist__title" href={v.url} rel="noopener noreferrer">{v.title}</a>
            <span class="videolist__meta">
              <span><strong>{v.channel}</strong></span>
              <span>·</span>
              <span>{CREDENTIAL_LABEL[v.credential]}</span>
              <span>·</span>
              <span>{v.language}</span>
              {GENERAL_VIDEOS.includes(v) && <span>· general open-gym</span>}
            </span>
            <p class="tiny muted" style="margin:5px 0 0">{v.credentialNote} {v.scope}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="detail-section" id="station">
      <h2><span class="num">02</span> Find a demo from a station</h2>
      <p class="small">
        Every station page carries the general demos above plus any station-specific clip we found.
        Start from <a href={u("/equipment")}>the catalogue</a> and open the station you have in
        front of you.
      </p>
    </section>
  </div>
</Base>
